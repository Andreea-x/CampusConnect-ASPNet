@model IEnumerable<Message>
@{
    ViewData["Title"] = "Messages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">My Messages</h1>
        <p class="text-muted mb-0">Track support messages you have sent.</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">New Message</a>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body py-4 text-center text-muted">No messages found.</div>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <div class="fw-semibold">Your Message</div>
                                <div class="event-meta">@item.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                            @if (string.IsNullOrWhiteSpace(item.AdminReply))
                            {
                                <span class="badge text-bg-warning">Awaiting reply</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Replied</span>
                            }
                        </div>

                        <div class="p-3 rounded bg-light mb-3">
                            @item.Content
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.AdminReply))
                        {
                            <div class="border-top pt-3">
                                <div class="fw-semibold mb-1">Support Reply</div>
                                <div class="event-meta mb-2">@item.RepliedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                                <div class="p-3 rounded reply-panel">
                                    @item.AdminReply
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

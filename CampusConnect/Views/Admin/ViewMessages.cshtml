@model IEnumerable<AdminMessageViewModel>
@{
    ViewData["Title"] = "User Messages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">User Messages</h1>
        <p class="text-muted mb-0">Review support requests submitted by students.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Admin</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Student</th>
                <th>Email</th>
                <th>Message</th>
                <th>Reply Status</th>
                <th>Sent At</th>
                <th class="text-end">Action</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">No messages found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.StudentEmail</td>
                        <td>@item.Content</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(item.AdminReply))
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                            else
                            {
                                <div class="small">
                                    <span class="badge text-bg-success mb-1">Replied</span>
                                    <div class="text-muted">@item.RepliedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                                </div>
                            }
                        </td>
                        <td>@item.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td class="text-end">
                            <a asp-action="ReplyMessage" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                @(string.IsNullOrWhiteSpace(item.AdminReply) ? "Reply" : "Edit Reply")
                            </a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

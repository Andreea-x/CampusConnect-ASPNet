@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">Manage campus events and review student activity.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ViewRegistrations" class="btn btn-outline-primary">Registrations</a>
        <a asp-action="ViewMessages" class="btn btn-outline-primary">Messages</a>
        <a asp-action="CreateEvent" class="btn btn-accent">Create Event</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card h-100">
            <span class="stat-label">Total Events</span>
            <strong>@Model.TotalEventsCount</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card h-100">
            <span class="stat-label">Total Registrations</span>
            <strong>@Model.TotalRegistrationsCount</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card h-100">
            <span class="stat-label">Total Messages</span>
            <strong>@Model.TotalMessagesCount</strong>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Capacity</th>
                <th>Registrations</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Events.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No events available.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Events)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.EventDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>@item.Capacity</td>
                        <td>@item.Registrations.Count</td>
                        <td class="text-end">
                            <a asp-action="EditEvent" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this event?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@model IEnumerable<AdminRegistrationViewModel>
@{
    ViewData["Title"] = "All Registrations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">All Registrations</h1>
        <p class="text-muted mb-0">Monitor event participation across the platform.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Admin</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Student</th>
                <th>Email</th>
                <th>Event</th>
                <th>Event Date</th>
                <th>Registered On</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No registrations found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.StudentEmail</td>
                        <td>@item.EventTitle</td>
                        <td>@item.EventDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>@item.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

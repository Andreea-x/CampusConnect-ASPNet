@model IEnumerable<Event>
@{
    ViewData["Title"] = "Events";
    var registeredEventIds = ViewBag.RegisteredEventIds as List<int> ?? new List<int>();
}

<section class="section-panel mb-4">
<div class="section-header">
    <div>
        <div class="section-kicker">Student Activities</div>
        <h1 class="mb-1">Campus Events</h1>
        <p class="section-copy mb-0">Browse all available university events and activities across the campus community.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Admin" asp-action="CreateEvent" class="btn btn-accent">Create Event</a>
    }
</div>
</section>

<div class="row g-4">
    @foreach (var item in Model)
    {
        var seatsLeft = item.Capacity - item.Registrations.Count;
        var isRegistered = registeredEventIds.Contains(item.Id);
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 event-card border-0">
                <div class="event-card-topbar"></div>
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div class="event-date-pill">@item.EventDate.ToLocalTime().ToString("dddd, dd MMM yyyy")</div>
                        <span class="badge event-capacity-badge">Seats left: @seatsLeft</span>
                    </div>
                    <h2 class="h4">@item.Title</h2>
                    <p class="text-muted flex-grow-1">@(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)</p>
                    <div class="event-meta mb-3">@item.EventDate.ToLocalTime().ToString("hh:mm tt")</div>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="event-inline-note">Campus engagement event</span>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Details</a>
                            @if (User.IsInRole("Student"))
                            {
                                if (isRegistered)
                                {
                                    <span class="btn btn-outline-success disabled">Registered</span>
                                }
                                else if (seatsLeft <= 0)
                                {
                                    <span class="btn btn-outline-secondary disabled">Full</span>
                                }
                                else
                                {
                                    <form asp-action="Register" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-accent">Register</button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusConnect.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">CampusConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Event" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ViewRegistrations">Registrations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ViewMessages">Messages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Announcements" asp-action="Index">Announcements</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Event" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Announcements" asp-action="Index">Announcements</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Registration" asp-action="MyRegistrations">My Registrations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Message" asp-action="Index">Messages</a>
                            </li>
                        }
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>

<main class="pb-5 flex-grow-1">
    <div class="page-shell container py-4">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>
</main>

<footer class="app-footer">
    <div class="container">
        <div class="footer-card">
            <div class="row g-4 align-items-start">
                <div class="col-lg-5">
                    <div class="footer-brand">CampusConnect</div>
                    <p class="footer-copy mb-0">
                        A central student engagement platform for university events, registrations, and support communication.
                    </p>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="footer-title">Quick Links</div>
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Event" asp-action="Index">Events</a>
                        <a asp-controller="Announcements" asp-action="Index">Announcements</a>
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                        {
                            <a asp-controller="Registration" asp-action="MyRegistrations">My Registrations</a>
                            <a asp-controller="Message" asp-action="Index">Messages</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                            <a asp-controller="Admin" asp-action="ViewRegistrations">Registrations</a>
                            <a asp-controller="Admin" asp-action="ViewMessages">Messages</a>
                            <a asp-controller="Announcements" asp-action="Index">Announcements</a>
                        }
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="footer-title">Platform Purpose</div>
                    <div class="footer-note">
                        Built for managing student participation, improving visibility of campus activities, and simplifying communication between students and administrators.
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 CampusConnect</span>
                <span>ASP.NET Core MVC Coursework Project</span>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
